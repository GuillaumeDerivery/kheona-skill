  "kskill-renovate.yml": {
    "caller": "kskill-renovate.yml",
    "dispatchInputs": [
      "dry_run",
      "repositories"
    ],
    "events": {
      "workflow_dispatch": {
        "inputs": {
          "dry_run": {
            "default": false,
            "description": "Renovate's dryRun full: everything resolved and logged, no branch, PR or merge",
            "type": "boolean"
          },
          "repositories": {
            "default": "",
            "description": "Only these repositories (space-separated owner/repo); empty means every one",
            "required": false
          }
        }
      }
    },
    "inputTypes": {
      "dry_run": "boolean",
      "repositories": "string"
    },
    "name": "Kheona Skill \u00b7 Renovate",
    "permissions": {
      "contents": "read",
      "id-token": "write"
    },
    "secrets": [],
    "stack": false
