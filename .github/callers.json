{
  "kskill-claude.yml": {
    "caller": "kskill-claude.yml",
    "dispatchInputs": [],
    "events": {
      "issue_comment": {
        "types": [
          "created"
        ]
      },
      "pull_request_review_comment": {
        "types": [
          "created"
        ]
      }
    },
    "inputTypes": {},
    "name": "Kheona Skill \u00b7 Claude",
    "permissions": {
      "contents": "read",
      "id-token": "write",
      "issues": "read",
      "pull-requests": "read"
    },
    "secrets": [
      "CLAUDE_CODE_OAUTH_TOKEN"
    ],
    "stack": false
  },
  "kskill-deliver-flutter.yml": {
    "caller": "kskill-deliver.yml",
    "dispatchInputs": [],
    "events": {
      "push": {
        "tags": [
          "v*"
        ]
      },
      "workflow_dispatch": {}
    },
    "inputTypes": {},
    "name": "Kheona Skill \u00b7 Deliver",
    "permissions": {
      "actions": "read",
      "contents": "read",
      "id-token": "write",
      "pull-requests": "read"
    },
    "pin": "tag",
    "secrets": [
      "ANDROID_KEYSTORE_BASE64",
      "ASC_API_KEY_BASE64",
      "ASC_ISSUER_ID",
      "ASC_KEY_ID",
      "CM_KEYSTORE_PASSWORD",
      "CM_KEY_ALIAS",
      "CM_KEY_PASSWORD",
      "IOS_DIST_CERTIFICATE_P12_BASE64",
      "IOS_DIST_CERTIFICATE_PASSWORD",
      "PLAY_STORE_JSON_KEY_BASE64",
      "SENTRY_AUTH_TOKEN"
    ],
    "stack": true
  },
  "kskill-deploy.yml": {
    "caller": "kskill-deploy.yml",
    "custom": true,
    "dispatchInputs": [],
    "events": {
      "push": {
        "tags": [
          "v*"
        ]
      },
      "workflow_dispatch": {}
    },
    "inputTypes": {},
    "name": "Kheona Skill \u00b7 CD \u00b7 Build, push and deploy",
    "permissions": {
      "actions": "read",
      "contents": "read",
      "id-token": "write",
      "pull-requests": "read"
    },
    "pin": "tag",
    "secrets": [
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "SLACK_WEBHOOK_URL"
    ],
    "stack": true
  },
  "kskill-inbox.yml": {
    "caller": "kskill-inbox.yml",
    "dispatchInputs": [
      "job"
    ],
    "events": {
      "repository_dispatch": {
        "types": [
          "lib-released",
          "upstream-updated"
        ]
      },
      "workflow_dispatch": {
        "inputs": {
          "job": {
            "description": "The job to run",
            "options": [
              "bump-lib",
              "sync-upstream",
              "sentry-triage",
              "mutation",
              "refresh-flutter",
              "security-scan"
            ],
            "required": true,
            "type": "choice"
          }
        }
      }
    },
    "inputTypes": {
      "job": "choice"
    },
    "name": "Kheona Skill \u00b7 Inbox",
    "permissions": {
      "actions": "read",
      "contents": "read",
      "id-token": "write",
      "issues": "read"
    },
    "secrets": [
      "CLAUDE_CODE_OAUTH_TOKEN",
      "SENTRY_AUTH_TOKEN"
    ],
    "stack": false
  },
