{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "The Kheona policy where a merge to the default branch deploys production (.kheona.json workflows.automerge.enabled false): nothing merges automatically.",
  "extends": [
    "github>GuillaumeDerivery/kheona-skill//renovate/default"
  ],
  "lockFileMaintenance": {
    "automerge": false,
    "labels": [
      "dependencies"
    ]
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "major",
        "lockFileMaintenance"
      ],
      "automerge": false,
      "labels": [
        "dependencies"
      ]
    }
  ]
}
